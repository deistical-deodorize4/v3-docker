# ==========================================
# Pi Zero 2W Homelab
# All services in Docker
# ==========================================

TZ=Europe/Madrid
COMPOSE_PROJECT_NAME=pi-homelab

# --- WIREGUARD (wg-easy v15) ---
# Unattended setup runs once on the first start of the container.
INIT_ENABLED=true
# Public IP or DDNS hostname clients will connect to
INIT_HOST=vpn.example.com
# UDP port clients connect to and WireGuard listens on
INIT_PORT=51820
# DNS handed to VPN clients (use a public resolver; the Pi itself does not
# serve DNS, so pointing clients at the Pi's IP leaves them without DNS)
INIT_DNS=1.1.1.1
# wg-easy admin account (created by the unattended setup above)
WG_ADMIN_USERNAME=admin
# Set a strong password here to create the admin automatically.
# Leave empty to create it manually via the web setup wizard on first start.
WG_ADMIN_PASSWORD=

# --- MESHMONITOR (BLE Bridge) ---
# BLE_ADDRESS is required — set to your Meshtastic device's Bluetooth MAC.
# Find it by running (on the Pi):
#   docker run --rm --privileged -v /var/run/dbus:/var/run/dbus \
#     ghcr.io/yeraze/meshtastic-ble-bridge:latest --scan
# BLE_ADDRESS=AA:BB:CC:DD:EE:FF

# --- TELEGRAM HUB (optional, read-only in FileBrowser) ---
# Path to the pi02w-hub data directory. It appears as a read-only
# 'pi02w-hub' folder inside FileBrowser. If unset, defaults to
# /home/pi/pi02w-hub/data (the Pi deploy path). Leave as-is on the Pi.
# HUB_DATA_DIR=/home/pi/pi02w-hub/data

# --- PORTS ---
# wg-easy admin UI port (bound to localhost; use an SSH tunnel to reach it)
WG_UI_PORT=51822
